#: loan_app/views.py:799
msgid "You do not have permission to approve repayments."
msgstr "পরিশোধ অনুমোদনের অনুমতি আপনার নেই।"

#: loan_app/views.py:804 loan_app/views.py:823
msgid "This repayment has already been processed."

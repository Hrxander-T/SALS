#: loan_app/views.py:811
#, python-format
msgid "Repayment #%s approved!"
msgstr "পরিশোধ #%s অনুমোদিত হয়েছে!"

#: loan_app/views.py:818
msgid "You do not have permission to reject repayments."
msgstr "পরিশোধ বাতিল করার অনুমতি আপনার নেই।"

#: loan_app/views.py:830
#, python-format
msgid "Repayment #%s rejected!"
msgstr "পরিশোধ #%s বাতিল করা হয়েছে!"

#: loan_app/views.py:837
msgid "You do not have permission to record repayments."
msgstr "পরিশোধ নথিভুক্ত করার অনুমতি আপনার নেই।"

#: loan_app/views.py:843 loan_app/views.py:921
msgid "Only approved loans can have repayments."
msgstr "শুধুমাত্র অনুমোদিত ঋণের পরিশোধ গ্রহণ করা যাবে।"

#: loan_app/views.py:851 loan_app/views.py:929
msgid "This loan has been fully repaid."
msgstr "এই ঋণ সম্পূর্ণ পরিশোধ করা হয়েছে।"

#: loan_app/views.py:864
msgid "Repayment recorded and approved successfully!"
msgstr "পরিশোধ সফলভাবে নথিভুক্ত ও অনুমোদিত হয়েছে!"

#: loan_app/views.py:879
msgid "Farmer access only."
msgstr "শুধুমাত্র কৃষকদের জন্য প্রবেশাধিকার।"

#: loan_app/views.py:939
msgid "Repayment recorded successfully!"
msgstr "পরিশোধ সফলভাবে নথিভুক্ত হয়েছে!"

#: loan_app/views.py:970
msgid "You do not have permission to view farmers."
msgstr "কৃষকদের তথ্য দেখার অনুমতি আপনার নেই।"

#: loan_app/views.py:987
msgid "Only farmers can upload NID cards."
msgstr "শুধুমাত্র কৃষকরাই এনআইডি কার্ড আপলোড করতে পারবেন।"

#: loan_app/views.py:994
msgid "NID card uploaded successfully!"
msgstr "এনআইডি কার্ড সফলভাবে আপলোড হয়েছে!"

#: loan_app/views.py:1004
msgid "You do not have permission to verify NID."
msgstr "এনআইডি যাচাই করার অনুমতি আপনার নেই।"

#: loan_app/views.py:1037
msgid "You do not have permission to view this page."
msgstr "এই পৃষ্ঠা দেখার অনুমতি আপনার নেই।"


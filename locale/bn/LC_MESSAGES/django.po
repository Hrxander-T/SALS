#: loan_app/views.py:450
msgid "Registration successful!"
msgstr "নিবন্ধন সফল হয়েছে!"

#: loan_app/views.py:464
#, python-format
msgid "Welcome back, %s!"
msgstr "আবার স্বাগতম, %s!"

#: loan_app/views.py:467
msgid "Invalid username or password."
msgstr "ব্যবহারকারীর নাম বা পাসওয়ার্ড সঠিক নয়।"

#: loan_app/views.py:473
msgid "You have been logged out."
msgstr "আপনি সফলভাবে লগ আউট হয়েছেন।"

#: loan_app/views.py:483
msgid "Profile updated successfully!"
msgstr "প্রোফাইল সফলভাবে হালনাগাদ হয়েছে!"

#: loan_app/views.py:522
msgid "Please complete your farmer profile."
msgstr "অনুগ্রহ করে আপনার কৃষক প্রোফাইল সম্পূর্ণ করুন।"

#: loan_app/views.py:532
msgid "You do not have permission to view this profile."
msgstr "এই প্রোফাইল দেখার অনুমতি আপনার নেই।"

#: loan_app/views.py:549
msgid "You already have a profile."
msgstr "আপনার ইতোমধ্যে একটি প্রোফাইল রয়েছে।"

#: loan_app/views.py:558
msgid "Farmer profile created successfully!"
msgstr "কৃষক প্রোফাইল সফলভাবে তৈরি হয়েছে!"

#: loan_app/views.py:577
msgid "Farmer profile updated successfully!"
msgstr "কৃষক প্রোফাইল সফলভাবে হালনাগাদ হয়েছে!"

#: loan_app/views.py:591 loan_app/views.py:611
msgid "Please complete your farmer profile first."
msgstr "অনুগ্রহ করে প্রথমে আপনার কৃষক প্রোফাইল সম্পূর্ণ করুন।"

#: loan_app/views.py:600
msgid "Document uploaded successfully!"
msgstr "দলিল সফলভাবে আপলোড হয়েছে!"

#: loan_app/views.py:602
msgid "Please select a file to upload."
msgstr "আপলোড করার জন্য একটি ফাইল নির্বাচন করুন।"

#: loan_app/views.py:615
msgid "You already have a loan application."
msgstr "আপনার ইতোমধ্যে একটি ঋণের আবেদন রয়েছে।"

#: loan_app/views.py:694
msgid "Only approved loans can download the approval letter."
msgstr "শুধুমাত্র অনুমোদিত ঋণের জন্য অনুমোদনপত্র ডাউনলোড করা যাবে।"

#: loan_app/views.py:712
msgid "Repayment not found."
msgstr "পরিশোধের তথ্য পাওয়া যায়নি।"

#: loan_app/views.py:718
msgid "You do not have permission to download this receipt."
msgstr "এই রসিদ ডাউনলোড করার অনুমতি আপনার নেই।"

#: loan_app/views.py:749
msgid "You do not have permission to approve loans."
msgstr "ঋণ অনুমোদনের অনুমতি আপনার নেই।"

#: loan_app/views.py:756
#, python-format
msgid "Loan application #%s approved!"
msgstr "ঋণের আবেদন #%s অনুমোদিত হয়েছে!"

#: loan_app/views.py:763
msgid "You do not have permission to reject loans."
msgstr "ঋণ বাতিল করার অনুমতি আপনার নেই।"

#: loan_app/views.py:770
#, python-format
msgid "Loan application #%s rejected!"
